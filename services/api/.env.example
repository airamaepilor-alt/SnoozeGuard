NODE_ENV=development
PORT=4000

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

IOT_INGEST_SECRET=dev-secret-change-me-16chars
IOT_DEFAULT_USER_ID=

# Optional: override for npm run demo:iot (default http://127.0.0.1:4000)
# DEMO_API_URL=http://127.0.0.1:4000

# Optional MQTT ingest (same JSON as REST). Omit both to disable.
# MQTT_BROKER_URL=mqtt://localhost:1883
# MQTT_TOPIC=snoozeguard/+/telemetry
# MQTT_USERNAME=
# MQTT_PASSWORD=
