# Copy to apps/web/.env for Vite (prefix VITE_)
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# API service (services/api/.env)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...  # server only — never expose to clients
# IOT_INGEST_SECRET=change-me-min-16-chars
# IOT_DEFAULT_USER_ID=uuid-of-driver-for-iot-rows
# PORT=4000
